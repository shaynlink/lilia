{
  "name": "lilia-plugin-sql",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "plugins/lilia-plugin-sql/src",
  "implicitDependencies": ["lilia-plugin-api"],
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "cargo build -p lilia-plugin-sql" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "cargo test -p lilia-plugin-sql" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "cargo clippy -p lilia-plugin-sql --all-targets -- -D warnings" } },
    "bench": { "executor": "nx:run-commands", "options": { "command": "cargo bench -p lilia-plugin-sql --no-run" } },
    "package": { "executor": "nx:run-commands", "options": { "command": "cargo build -p lilia-plugin-sql --release" } }
  },
  "tags": ["scope:model", "type:plugin", "lang:rust"]
}
