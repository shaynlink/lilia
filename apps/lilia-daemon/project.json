{
  "name": "lilia-daemon",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/lilia-daemon/src",
  "implicitDependencies": ["lilia-core", "lilia-plugin-api", "lilia-protocol", "lilia-storage-sqlite"],
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "cargo build -p lilia-daemon" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "cargo test -p lilia-daemon" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "cargo clippy -p lilia-daemon --all-targets -- -D warnings" } },
    "bench": { "executor": "nx:run-commands", "options": { "command": "cargo bench -p lilia-daemon --no-run" } },
    "package": { "executor": "nx:run-commands", "options": { "command": "cargo build -p lilia-daemon --release" } }
  },
  "tags": ["scope:daemon", "type:application", "lang:rust"]
}
