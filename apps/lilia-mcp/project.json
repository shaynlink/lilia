{
  "name": "lilia-mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/lilia-mcp/src",
  "implicitDependencies": ["lilia-core", "lilia-storage-sqlite"],
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "cargo build -p lilia-mcp" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "cargo test -p lilia-mcp" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "cargo clippy -p lilia-mcp --all-targets -- -D warnings" } },
    "bench": { "executor": "nx:run-commands", "options": { "command": "cargo bench -p lilia-mcp --no-run" } },
    "package": { "executor": "nx:run-commands", "options": { "command": "cargo build -p lilia-mcp --release" } }
  },
  "tags": ["scope:mcp", "type:application", "lang:rust"]
}
